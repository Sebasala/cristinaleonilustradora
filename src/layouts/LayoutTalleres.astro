---
import Footer from "@components/Footer.astro";
import { artistName, logo, logoAlt } from "@config";
import contenido from "@data/taller-ilustracion-poetica";
import LayoutGlobal from "@layouts/LayoutGlobal.astro";
import '@styles/global.scss';

const { metadata } = contenido;
---

<LayoutGlobal
	title={metadata.title}
	description={metadata.description}
	geo={metadata.geo}
	og={metadata.og}
>
	<body>
		<header>
			<h2>{artistName}</h2>
			<img class="logo" src={logo} alt={logoAlt}>
		</header>
		<slot />
		<Footer />
	</body>
</LayoutGlobal>

<style>
	header {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.logo {
		height: 3rem;
	}

	h2 {
		margin: 0;
	}
</style>

