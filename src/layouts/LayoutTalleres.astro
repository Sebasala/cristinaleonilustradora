---
import Footer from "@components/Footer.astro";
import '@styles/global.scss';
const talleresUrl = new URL("/talleres", Astro.site).toString();
const {
	title,
	description,
	titleSuffix = "Cristina León Arte | Bogotá, Colombia",
	ogTitle = "Cristina León Artista",
	ogDescription = "Portafolio con ilustraciones de la artista plástica Cristina León de Bogotá Colombia",
	ogType = "website",
	ogUrl = talleresUrl,
	ogImage = "/img/cristina-leon-ilustradora-optimizado.svg"
} = Astro.props;
const properties = {
	sufix: titleSuffix,
	heading: "Cristina León",
	pages: {
		portafolio: {
			href: "/",
			label: "Portafolio"
		},
		biografia: {
			href: "/biografia",
			label: "Biografía"
		}
	}
};
const { sufix, heading } = properties;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<title>{title} | {sufix}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={ogTitle} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={ogUrl} />
		<meta property="og:image" content={ogImage} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg" href="/img/logos/cl.svg" />
		<meta name="generator" content={Astro.generator} />
	</head>
	<body>
		<header>
			<h2>{heading}</h2>
			<img class="logo" src="/img/logos/cristina-leon-ilustradora-optimizado.svg" alt="Cristina León Ilustradora, Bogotá, Colombia">
		</header>
		<slot />
		<Footer />
	</body>
</html>

<style>
	header {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.logo {
		height: 3rem;
	}

	h2 {
		margin: 0;
	}
</style>

