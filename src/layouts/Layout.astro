---
import Footer from "@components/Footer.astro";
import LayoutGlobal from "@layouts/LayoutGlobal.astro";
import '@styles/global.scss';
const { title, url } = Astro.props;
const properties = {
	sufix: "Cristina León Artísta | Bogotá, Colombia",
	heading: "Cristina León",
	pages: {
		portafolio: {
			href: "/",
			label: "Portafolio"
		},
		biografia: {
			href: "/biografia",
			label: "Biografía"
		}
	}
};
const { sufix, heading, pages } = properties;
const { portafolio, biografia } = pages;
const isPortafolio = url === portafolio.href;
const isBiografia = url === biografia.href;

const metadata = {
	description: "Portafolio con ilustraciones de la artista plástica Cristina León de Bogotá Colombia",
	icon: "/img/logos/cl.svg",
	og: {
		title: 'Portafolio de Cristina León'
	}
};
---

<LayoutGlobal
	title={title}
	titleSuffix={sufix}
	description={metadata.description}
	og={metadata.og}
>
	<body>
		<header>
		
			<div class="logo">
				<a href="http://cristinaleonilustradora.com/" title="Cristina León Ilustradora, Bogotá, Colombia" class="link-img">
				<img src="/img/logos/cl.svg" alt="Cristina León Ilustradora, Bogotá, Colombia">
				</a>
			</div>
	
			<a href="http://cristinaleonilustradora.com/" title="Cristina León Ilustradora, Bogotá, Colombia">
			<h1>{heading}</h1>
			</a>

			<nav>
				<ul class="nav-links-list">
					<li>
						<a class:list={["nav-link", "gradient", isPortafolio && "current-page"]} href={portafolio.href}>{portafolio.label}</a>
					</li>
					<li>
						<a class:list={["nav-link", isBiografia && "current-page"]} href={biografia.href}>{biografia.label}</a>
					</li>
				</ul>
			</nav>
	
		</header>
		<slot />
		<Footer />
	</body>
</LayoutGlobal>

<style>
	li {
		margin-bottom: 0;
		opacity: var(--opacity-full);
	}

	.logo {
		margin-bottom: var(--space);
	}

	.gradient {
		background: linear-gradient(
			90deg,
			rgb(20, 96, 20),
			rgb(41, 41, 178), 
			rgb(179, 38, 179), 
			rgb(175, 34, 34), 
			rgb(171, 125, 40), 
			rgb(177, 177, 41), 
			rgb(20, 96, 20),
			rgb(41, 41, 178)
		);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}
</style>
