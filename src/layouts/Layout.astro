---
import Footer from "@components/Footer.astro";
import LayoutGlobal from "@layouts/LayoutGlobal.astro";
import '@styles/global.scss';
const { title, url } = Astro.props;
const properties = {
	sufix: "Cristina León Artísta | Bogotá, Colombia",
	heading: "Cristina León",
	pages: [
		{
			href: "/",
			label: "Portafolio",
			hasGradient: true
		},
		{
			href: "/biografia",
			label: "Biografía"
		},
		/*
		{
			href: "/talleres",
			label: "Talleres"
		}
		*/
	]
};
const { sufix, heading, pages } = properties;


const metadata = {
	description: "Portafolio con ilustraciones de la artista plástica Cristina León de Bogotá Colombia",
	icon: "/img/logos/cl.svg",
	og: {
		title: 'Portafolio de Cristina León'
	}
};
---

<LayoutGlobal
	title={title}
	titleSuffix={sufix}
	description={metadata.description}
	og={metadata.og}
>
	<body>
		<header>
		
			<div class="logo">
				<a href="http://cristinaleonilustradora.com/" title="Cristina León Ilustradora, Bogotá, Colombia" class="link-img">
					<img src="/img/logos/cl.svg" alt="Cristina León Ilustradora, Bogotá, Colombia">
					<h1>{heading}</h1>
				</a>
			</div>

			<nav>
				<ul class="nav-links-list">
					{pages.map((page) => (
						<li>
							<a class:list={["nav-link", page.href === url && "current-page", page.hasGradient && "gradient"]} href={page.href}>{page.label}</a>
						</li>
					))}
				</ul>
			</nav>
	
		</header>
		<slot />
		<Footer />
	</body>
</LayoutGlobal>

<style lang="scss">
	@use "../styles/base/breakpoints" as *;

	body {
		@media screen and (min-width: $breakpoint-tablet) {
			padding: var(--space-2);
		}
	}
	
	li {
		margin-bottom: 0;
		opacity: var(--opacity-full);
	}

	.logo {
		margin-bottom: var(--space);
		height: var(--space-2);

		a {
			display: inline-flex;
			align-items: center;
		}

		img {
			height: var(--space-2);
			margin-right: var(--space);
		}

		h1 {
			margin: 0;
		}
	}

	.gradient {
		background: linear-gradient(
			90deg,
			rgb(20, 96, 20),
			rgb(41, 41, 178), 
			rgb(179, 38, 179), 
			rgb(175, 34, 34), 
			rgb(171, 125, 40), 
			rgb(177, 177, 41), 
			rgb(20, 96, 20),
			rgb(41, 41, 178)
		);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}
</style>
