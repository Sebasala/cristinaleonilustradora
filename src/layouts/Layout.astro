---
import Footer from "@components/Footer.astro";
import LayoutGlobal from "@layouts/LayoutGlobal.astro";
import '@styles/global.scss';
const { title, description, og, url, structuredData } = Astro.props;
console.log({url});
const properties = {
	heading: "Cristina León",
	pages: [
		{
			href: "/",
			label: "Portafolio",
			hasGradient: true
		},
		{
			href: "/calendario",
			label: "Calendario"
		},
		{
			href: "/talleres/ilustracion-poetica/",
			label: "Taller"
		},
		{
			href: "/biografia",
			label: "Biografía"
		}
	]
};
const { heading, pages } = properties;
const whatsappPhone = import.meta.env.ADMIN_WHATSAPP_PHONE;
const whatsappHref = whatsappPhone ? `https://wa.me/${whatsappPhone}` : undefined;
---

<LayoutGlobal
	title={title}
	description={description}
	og={og}
	structuredData={structuredData}
>
	<body>
		<header>
		
			<div class="logo">
				<a href="/" title="Cristina León Ilustradora, Bogotá, Colombia">
					<img src="/img/logos/cl.svg" alt="Cristina León Ilustradora, Bogotá, Colombia">
					<div>
						<h1>{heading}</h1>
						<p>Artista Plástica</p>
					</div>
				</a>
			</div>

			<nav>
				<!-- // TODO: Make it hamburger on mobile -->
				<ul class="nav-links-list">
					{pages.map((page) => (
						<li class:list={["nav-item", page.href === url && "current-page"]}>
							<a class="nav-link" href={page.href}>{page.label}</a>
						</li>
					))}
				</ul>
			</nav>
	
		</header>
		<slot />
		<Footer />
		{whatsappHref && (
			<a
				class="whatsapp-float"
				href={whatsappHref}
				aria-label="Escríbeme por WhatsApp"
				target="_blank"
				rel="noopener noreferrer"
			>
				<img class="icon" src="/icons/whatsapp.svg">
			</a>
		)}
	</body>
</LayoutGlobal>

<style lang="scss">
	@use "../styles/base/breakpoints" as *;

	body {
		@media screen and (min-width: $breakpoint-desktop) {
			padding: var(--space-2);
		}
	}

	header {
		@media screen and (min-width: $breakpoint-desktop) {
			display: flex;
			justify-content: space-between;
			align-items: center;
		}
	}

	li {
		margin-bottom: 0;
		opacity: var(--opacity-high);
	}
	.nav-links-list {
		display: flex;
		justify-content: space-between;
		margin-bottom: 0;
		flex-wrap: wrap;
	}

	.nav-link {
		color: var(--color-text);
	}

	.logo {
		margin-bottom: var(--space);
		height: var(--space-2);

		a {
			display: inline-flex;
			align-items: center;
		}

		img {
			height: var(--space-2);
			margin-right: var(--space);
		}

		h1 {
			margin: 0;
		}

		p {
			font-size: 18.5px;
		}

		@media screen and (min-width: $breakpoint-desktop) {
			margin-bottom: 0;
		}
	}

	.current-page {
		opacity: 1;
		.nav-link{
			background: linear-gradient(
			90deg,
			rgb(3, 94, 3),
			rgb(13, 13, 180), 
			rgb(181, 11, 181), 
			rgb(173, 13, 13), 
			rgb(125, 84, 6), 
			rgb(107, 107, 4), 
			rgb(3, 96, 3),
			rgb(14, 14, 180)
		);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;}
	}

	.whatsapp-float {
		position: fixed;
		right: var(--space);
		bottom: var(--space);
		z-index: 10;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: calc(var(--space-half) * 0.5);
		border-radius: calc(var(--space-2) * 2);
		background: var(--color-white);
		box-shadow: var(--box-shadow);
		color: var(--color-black);
		width: calc(var(--space) * 2);
		height: calc(var(--space) * 2);
		transition: transform 0.2s ease, box-shadow 0.2s ease;

		&:hover,
		&:focus-visible {
			transform: translateY(-2px);
			box-shadow: 2px 6px 12px rgba(0, 0, 0, 0.28);
		}

		&:focus-visible {
			outline: 3px solid var(--color-accent);
			outline-offset: 3px;
		}
	}
</style>
