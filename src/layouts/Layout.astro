---
import Footer from "@components/Footer.astro";
import LayoutGlobal from "@layouts/LayoutGlobal.astro";
import '@styles/global.scss';
const { title, description, og, url, structuredData } = Astro.props;
const properties = {
	heading: "Cristina León",
	pages: [
		{
			href: "/",
			label: "Portafolio",
			hasGradient: true
		},
		{
			href: "/biografia",
			label: "Biografía"
		},
		{
			href: "/talleres/ilustracion-poetica/",
			label: "Taller"
		}
	]
};
const { heading, pages } = properties;
---

<LayoutGlobal
	title={title}
	description={description}
	og={og}
	structuredData={structuredData}
>
	<body>
		<header>
		
			<div class="logo">
				<a href="/" title="Cristina León Ilustradora, Bogotá, Colombia">
					<img src="/img/logos/cl.svg" alt="Cristina León Ilustradora, Bogotá, Colombia">
					<div>
						<h1>{heading}</h1>
						<p>Artista Plástica</p>
					</div>
				</a>
			</div>

			<nav>
				<ul class="nav-links-list">
					{pages.map((page) => (
						<li class:list={["nav-item", page.href === url && "current-page"]}>
							<a class="nav-link" href={page.href}>{page.label}</a>
						</li>
					))}
				</ul>
			</nav>
	
		</header>
		<slot />
		<Footer />
	</body>
</LayoutGlobal>

<style lang="scss">
	@use "../styles/base/breakpoints" as *;

	body {
		@media screen and (min-width: $breakpoint-tablet) {
			padding: var(--space-2);
		}
	}

	header {
		margin-bottom: calc(2 * var(--space-2));
		@media screen and (min-width: $breakpoint-tablet) {
			display: flex;
			justify-content: space-between;
			align-items: center;
		}
	}

	li {
		margin-bottom: 0;
		opacity: var(--opacity-high);
	}
	.nav-links-list {
		display: flex;
		justify-content: space-between;
		margin-bottom: 0;
	}

	.nav-link {
		color: var(--color-text);
	}

	.logo {
		margin-bottom: var(--space);
		height: var(--space-2);

		a {
			display: inline-flex;
			align-items: center;
		}

		img {
			height: var(--space-2);
			margin-right: var(--space);
		}

		h1 {
			margin: 0;
		}

		@media screen and (min-width: $breakpoint-tablet) {
			margin-bottom: 0;
		}
	}

	.current-page {
		opacity: 1;
		.nav-link{
			background: linear-gradient(
			90deg,
			rgb(3, 94, 3),
			rgb(13, 13, 180), 
			rgb(181, 11, 181), 
			rgb(173, 13, 13), 
			rgb(125, 84, 6), 
			rgb(107, 107, 4), 
			rgb(3, 96, 3),
			rgb(14, 14, 180)
		);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;}
	}
</style>
