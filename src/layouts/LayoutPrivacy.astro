---
import { artistName, contactEmail } from "@config";
import LayoutTalleres from "@layouts/LayoutTalleres.astro";

interface Frontmatter {
  activity: string;
  description: string;
  effectiveDate: string;
  identification: string;
  location: string;
  title: string;
  updatedDate: string;
  website: string;
}

interface Props {
  frontmatter: Frontmatter;
}

const {
  activity,
  description,
  effectiveDate,
  identification,
  location,
  title,
  updatedDate,
} = Astro.props.frontmatter;

const website =
  import.meta.env.SITE || "https://cristinaleonilustradora.com";
  
---

<LayoutTalleres
  title={title}
  description={description}
>
  <main class="privacy-policy">
    <header class="privacy-header">
      <p class="eyebrow">{artistName} | {activity}</p>
      <h2>{title}</h2>
      <p><strong>Fecha de entrada en vigencia:</strong> {effectiveDate}</p>
      <p><strong>Última actualización:</strong> {updatedDate}</p>
    </header>

    <slot />

    <section class="policy-contact">
      <h3>Contacto oficial</h3>
      <p>{artistName}<br />
      C.C {identification}<br />
      {location}<br />
      <a href={`mailto:${contactEmail}`}>{contactEmail}</a><br />
      <a href={website}>{website}</a></p>
    </section>
  </main>
</LayoutTalleres>

<style>
  .privacy-policy {
    padding: var(--space-2) 0;
  }

  .privacy-header {
    margin-bottom: var(--space-2);
  }
</style>
