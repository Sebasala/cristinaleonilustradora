---
import CtaSection from "@components/talleres/ilustracion-poetica/CtaSection.astro";
import EspacioSection from "@components/talleres/ilustracion-poetica/EspacioSection.astro";
import FaqSection from "@components/talleres/ilustracion-poetica/FaqSection.astro";
import FilosofiaSection from "@components/talleres/ilustracion-poetica/FilosofiaSection.astro";
import HeroSection from "@components/talleres/ilustracion-poetica/HeroSection.astro";
import LeadCaptureForm from "@components/talleres/ilustracion-poetica/LeadCaptureForm.astro";
import LogisticaSection from "@components/talleres/ilustracion-poetica/LogisticaSection.astro";
import MentoraSection from "@components/talleres/ilustracion-poetica/MentoraSection.astro";
import ProyectoSection from "@components/talleres/ilustracion-poetica/ProyectoSection.astro";
import RecorridoSection from "@components/talleres/ilustracion-poetica/RecorridoSection.astro";
import LayoutTalleres from "@layouts/LayoutTalleres.astro";
import contenido from "./contenido";

import cristina from "./assets/cristina.jpeg";
import hoja from "./assets/hoja.png";
import hoja2 from "./assets/hoja2.png";
import hongos from "./assets/hongos.png";
import pajaro from "./assets/pajaro.png";
import pez from "./assets/pez.png";
import planta from "./assets/planta.png";
import taller from "./assets/taller.jpeg";

const { metadata, hero, filosofia, espacio, proyecto, recorrido, mentora, logistica, form, faqs, cta } = contenido;

const ilustracionPoeticaUrl = new URL("/talleres/ilustracion-poetica", Astro.site).toString();
---

<LayoutTalleres
	title={metadata.title}
	description={metadata.description}
	 ogTitle={metadata.title}
	 ogDescription={metadata.description}
	 ogUrl={ilustracionPoeticaUrl}
	 ogImage={metadata.ogImage}
>
	<main class="poetica-page">
		<HeroSection content={hero} image={pajaro} />
		<FilosofiaSection content={filosofia} image={hoja} />
		<EspacioSection content={espacio} image={taller} />
		<ProyectoSection content={proyecto} image={pez} />
		<MentoraSection content={mentora} image={cristina} />
		<CtaSection content={cta} image={hoja} />
		<RecorridoSection content={recorrido} image={hongos} />
		<LogisticaSection content={logistica} image={hoja2}/>
		<FaqSection content={faqs} image={planta}/>
		
	</main>
	<LeadCaptureForm content={form} />
</LayoutTalleres>
