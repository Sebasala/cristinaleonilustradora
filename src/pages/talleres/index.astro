---
import TallerCard from '../../components/talleres/TallerCard.astro';
import LayoutTalleres from '../../layouts/LayoutTalleres.astro';
import pajaro from './ilustracion-poetica/assets/pajaro.png';

const content = {
  id: "ilustracion-poetica",
  title: "Taller de Ilustración Poética",
  subtitle: "Narrativa visual y lenguaje propio",
  slug: "/talleres/ilustracion-poetica/",
  image: {
    src: pajaro,
    alt: "Taller de Ilustración Poética en Cajicá con Cristina León",
  },
  badges: ["Presencial · Cajicá", "Cupo Reducido"],
  logistics: {
    duration: "8 encuentros · 24 horas",
    level: "Todos los niveles",
    format: "Mentoría de autor"
  },
  excerpt:
    "Un espacio íntimo en la Sabana para destrabar tu trazo, explorar la metáfora visual y transformar emociones en historias ilustradas.",
  ctaText: "Ver programa completo"
}
---

<LayoutTalleres
  title="Talleres"
  description="Explora los talleres de Cristina León en Bogotá."
>
  <main>
    <h1>Talleres</h1>
    
    <nav>
      <ul>
        <li>
          <TallerCard
            content={content}
          />
        </li>
      </ul>
    </nav>
  </main>
</LayoutTalleres>

<style>
  h1, ul  {
    margin: var(--space) 0 var(--space-2);
  }

  li {
    margin: 0 auto;
    opacity: var(--opacity-full);
  }
</style>
