---
import { Image } from "astro:assets";
import LayoutTalleres from '../../layouts/LayoutTalleres.astro';
import pajaro from './ilustracion-poetica/assets/pajaro.png';

const talleresUrl = new URL("/talleres", Astro.site).toString();
---

<LayoutTalleres
  title="Talleres"
  description="Explora los talleres de Cristina León en Bogotá."
  ogTitle="Talleres | Cristina León"
  ogDescription="Explora los talleres de Cristina León en Bogotá."
  ogUrl={talleresUrl}
>
  <main>
    <h1>Talleres</h1>
    
    <nav>
      <ul>
        <li>
          <a href="/talleres/ilustracion-poetica">
            <Image class="image" src={pajaro} alt="Pájaro" widths={[496]} />
            Taller de Ilustración Poética</a>
        </li>
      </ul>
    </nav>
  </main>
</LayoutTalleres>

<style>
  h1, ul  {
    margin-bottom: var(--space-2);
  }

  li {
    margin: 0 auto;
    opacity: var(--opacity-full);
  }
</style>
