---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Talleres">
  <main>
    <h1>Talleres</h1>
    <p>Bienvenido a nuestros talleres de ilustración</p>
    
    <nav>
      <ul>
        <li>
          <a href="/talleres/ilustracion-poetica">Taller de Ilustración Poética</a>
        </li>
      </ul>
    </nav>
  </main>
</Layout>

<style>
  main {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
  }

  h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  nav ul {
    list-style: none;
    padding: 0;
  }

  nav li {
    margin: 1rem 0;
  }

  nav a {
    font-size: 1.2rem;
    color: var(--color-primary, #333);
    text-decoration: none;
    border-bottom: 2px solid var(--color-primary, #333);
    transition: color 0.3s ease;
  }

  nav a:hover {
    color: var(--color-secondary, #666);
  }
</style>
