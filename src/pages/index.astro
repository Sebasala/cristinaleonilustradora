---
import { artistProfile, siteLanguage, siteUrl, websiteSchema } from '@config';
import images from '@data/images';
import Layout from '@layouts/Layout.astro';
import { Image } from 'astro:assets';

const description = 'Obra artística, pintura y narrativa visual de Cristina León. Portafolio de autor, proyectos editoriales y formación en artes plásticas en Colombia.';
const properties = {
	title: 'Cristina León — Artista Visual y Narrativa Gráfica',
	url: '/',
	structuredData: {
		'@context': 'https://schema.org',
		'@graph': [
			{ ...websiteSchema },
			{ ...artistProfile },
			{
				'@type': 'CollectionPage',
				'@id': `${siteUrl}/#portfolio`,
				url: siteUrl,
				name: 'Portafolio de Cristina León',
				description,
				isPartOf: { '@id': `${siteUrl}/#website` },
				about: { '@id': `${siteUrl}/#artist` },
				inLanguage: siteLanguage,
			},
		],
	},
	images,
	og: {
		description: 'Portafolio de obra pictórica, narrativa visual y talleres de arte de Cristina León.'
	}
}
const {
	title,
	url,
	structuredData,
	og,
} = properties;
---

<Layout title={title} description={description} url={url} og={og} structuredData={structuredData}>
	<main>
		{images.map((image) => (
			<Image src={image.src} alt={image.alt} />
		))}
	</main>
</Layout>

<style lang="scss">
	@use "../styles/base/breakpoints" as *;
	main {
		text-align: center;
		display: flex;
		flex-wrap: wrap;
		justify-content: start;
		
		@media screen and (min-width: $breakpoint-tablet) {
			max-width: calc(100% + var(--space-2));
			margin-left: calc(-2 * var(--space));
		}

		@media screen and (min-width: $breakpoint-desktop) {
			margin-left: 0;
		}
	}
	img {
		margin: 0 0 var(--space);
		box-shadow: var(--box-shadow);
		border-radius: calc(0.5 * var(--space-half));

		@media screen and (min-width: $breakpoint-tablet) {
			margin: 0 0 var(--space-2) var(--space-2);
			max-height: calc(16 * var(--space));
			width: auto;
		}
	}
</style>
