---
import cristina from "@assets/bio/cristina.jpeg";
import { artistProfile, siteLanguage, siteUrl } from '@config';
import Layout from '@layouts/Layout.astro';
import '@styles/global.scss';
import { Image } from 'astro:assets';

const title = 'Biografía';
const description = 'Artista visual y Maestra en Artes Plásticas por la Universidad de los Andes con posgrado en Ilustración para Publicaciones Infantiles y Juveniles en EINA Barcelona.';
const url = '/biografia';
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'ProfilePage',
			'@id': `${siteUrl}/biografia/#profile`,
			url: `${siteUrl}/biografia`,
			name: title,
			description,
			mainEntity: { '@id': `${siteUrl}/#artist` },
			inLanguage: siteLanguage,
		},
		{
			...artistProfile,
			alumniOf: [
				{
					'@type': 'EducationalOrganization',
					name: 'EINA, Escola de Disseny i Art',
					url: 'https://www.eina.cat/',
				},
				{
					'@type': 'EducationalOrganization',
					name: 'Universidad de los Andes',
					url: 'https://uniandes.edu.co/',
				},
				{
					'@type': 'EducationalOrganization',
					name: 'Universidad El Bosque',
					url: 'https://www.unbosque.edu.co/',
				},
			],
			knowsAbout: [
				'Acuarela',
				'Artes plásticas',
				'Dibujo',
				'Enseñanza artística',
				'Ilustración infantil',
				'Narrativa visual',
				'Pintura al óleo',
			],
		},
	],
};

const profileData = structuredData['@graph'][1];
const alumniOf = 'alumniOf' in profileData ? profileData.alumniOf : [];

const trabajo = [
	{
		text: 'Lecciones de Poesía para niños y niñas inquietos,\n Escritor: Luís García Montero, \n Ilustraciones: Cristina León \n Editorial Visor, 2016',
	},
	{
		text: 'Lecciones de poesía para niños inquietos, de Luis García Montero. \n Ilustraciones: Cristina León \n Cuadernos EX-LIBRIS, serie: Grandes Maestros. Agenda Cultural, Gimnasio Moderno, 2015',
	},
	{
		text: 'Exposición colectiva “De cero a  cien años” con el grupo: Postgrado en Ilustración para publicaciones infantiles y Juveniles, EINA. Barcelona, España 2013',
	},
	{
		text: 'Ilustraciones Textos Infantiles \n Libro: “Burbujas D, transición libro integrado”. \n Grupo Editorial EDUCAR. 2012',
	},
	{
		text: 'Ilustraciones. Libro \n “Burbujas D, transición libro integrado”. \n Grupo Editorial Educar. (2012) Bogotá.',
	},
	{
		text: 'Ilustraciones revista de Literatura “Phoenix” de la Universidad Nacional de Colombia. (2001)',
	},
	{
		text: 'Participante del Segundo concurso Bienal de Pintura y Escultura, \n BNA (Bolsa Nacional Agropecuaria), (2001) Bogotá.',
	},
	{
		text: 'Exposición Colectiva de Arte, Club Médico de Bogotá, 2000',
	},
];
---

<Layout title={title} description={description} url={url} structuredData={structuredData}>
	<main>
		<section class="intro">
			<Image class="image" src={cristina} alt="Cristina" widths={[496]} />
			<p>Cristina León es artista plástica e ilustradora infantil, quién mezcla la pasión por el dibujo con la enseñanza a niños entre los 4 y los 7 años. Ellos la contagian cada día con su fantasía y así inspiran la gran mayoría de sus dibujos. Uno de sus propósito es despertar la conciencia en los niños sobre el cuidado del medio ambiente y de todos los seres que habitamos en la tierra. Es por esta razón que la gran mayoría de sus ilustraciones son animales, que además de tener un gusto particular por ellos, son una razón para sensibilizar a otros, promoviendo el gusto y el amor por diferentes seres vivos.</p>
		</section>
		<section>
			<h2>Trabajo</h2>
			<ul>
				{trabajo.map((item) => (
					<li>{item.text}</li>
				))}
			</ul>
		</section>
		<section>
			<h2>Formación Académica</h2>
			<ul>
				{alumniOf.map((item: { name: unknown; }) => (
					<li>{item.name}</li>
				))}
			</ul>
		</section>
	</main>
</Layout>

<style lang="scss">
	@use "../../styles/base/breakpoints" as *;

	.intro {
		@media screen and (min-width: $breakpoint-tablet) {
			display: flex;
			flex-direction: row;
			gap: var(--space);
		}
	}
	.image {
		height: calc(11 * var(--space));
		width: 100%;
		max-width: calc(11 * var(--space));
		margin-bottom: var(--space);
		border-radius: var(--space);
	}
	li {
		white-space: pre-line;
	}

</style>
