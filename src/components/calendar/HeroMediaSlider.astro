---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import deskHero from '@assets/calendar/calendar-desk-hero.jpg';
import wallHero from '@assets/calendar/calendar-wall-hero.jpg';
import { calendarVariants, DEFAULT_VARIANT_ID, type CalendarVariantId } from '@data/calendarVariants';

interface Slide {
	asset: ImageMetadata;
	alt: string;
}

// Segunda foto de cada set es un placeholder hasta contar con más fotografías.
const sets: Record<CalendarVariantId, Slide[]> = {
	'desk-2027': [
		{ asset: deskHero, alt: calendarVariants['desk-2027'].alt },
		{ asset: wallHero, alt: 'Calendario de Escritorio 2027 - detalle de las ilustraciones' },
		{ asset: deskHero, alt: calendarVariants['desk-2027'].alt },
		{ asset: wallHero, alt: 'Calendario de Escritorio 2027 - detalle de las ilustraciones' }
	],
	'wall-2027': [
		{ asset: wallHero, alt: calendarVariants['wall-2027'].alt },
		{ asset: deskHero, alt: 'Calendario de Pared 2027 - detalle de las ilustraciones' },
	],
};

const variantIds = Object.keys(sets) as CalendarVariantId[];

const sliders = await Promise.all(
	variantIds.map(async (id) => ({
		id,
		slides: await Promise.all(
			sets[id].map(async (slide) => ({
				...slide,
				full: (await getImage({ src: slide.asset, width: 1600, quality: 70 })).src,
			}))
		),
	}))
);

const sizes =
	'(max-width: 320px) 272px, (max-width: 425px) 377px, (max-width: 760px) 496px, (max-width: 1200px) 670px, 594px';

const prevIcon = 'M15 5l-7 7 7 7';
const nextIcon = 'M9 5l7 7-7 7';
---

<div class="hero-slider" data-hero-slider>
	{
		sliders.map(({ id, slides }) => {
			const isDefault = id === DEFAULT_VARIANT_ID;
			return (
				<div class="slider" data-slider={id} hidden={!isDefault}>
					<div class="slider__track" tabindex="0" aria-label="Fotografías del calendario">
						{slides.map((slide, i) => (
							<div class="slider__slide" data-index={i} data-full={slide.full}>
								<Image
									src={slide.asset}
									alt={slide.alt}
									class="slider__img"
									widths={[272, 377, 496, 594, 670]}
									sizes={sizes}
									loading={isDefault && i === 0 ? 'eager' : 'lazy'}
									fetchpriority={isDefault && i === 0 ? 'high' : undefined}
									quality={40}
								/>
							</div>
						))}
					</div>

					<button type="button" class="slider__arrow slider__arrow--prev" aria-label="Imagen anterior">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d={prevIcon} /></svg>
					</button>
					<button type="button" class="slider__arrow slider__arrow--next" aria-label="Imagen siguiente">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d={nextIcon} /></svg>
					</button>

					<div class="slider-dots">
						{slides.map((_, i) => (
							<button
								type="button"
								class={`slider-dot ${i === 0 ? 'slider-dot--active' : ''}`}
								data-index={i}
								aria-label={`Ir a la imagen ${i + 1}`}
								aria-current={i === 0 ? 'true' : undefined}
							/>
						))}
					</div>
				</div>
			);
		})
	}

	<dialog class="lightbox-dialog" aria-label="Visor ampliado">
		<div class="lightbox-dialog__content">
			<button type="button" class="lightbox-dialog__close" aria-label="Cerrar">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
			</button>
			<button type="button" class="slider__arrow slider__arrow--prev lightbox-dialog__nav" aria-label="Imagen anterior">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d={prevIcon} /></svg>
			</button>
			<div class="lightbox-dialog__track">
				<div class="lightbox-dialog__slide"><img class="lightbox-dialog__img" alt="" draggable="false" /></div>
				<div class="lightbox-dialog__slide"><img class="lightbox-dialog__img" alt="" draggable="false" /></div>
				<div class="lightbox-dialog__slide"><img class="lightbox-dialog__img" alt="" draggable="false" /></div>
			</div>
			<button type="button" class="slider__arrow slider__arrow--next lightbox-dialog__nav" aria-label="Imagen siguiente">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d={nextIcon} /></svg>
			</button>
			<div class="slider-dots lightbox-dialog__dots"></div>
		</div>
	</dialog>
</div>

<script>
	import { selectedVariant as $selectedVariant } from '@stores/cartStore';

	const root = document.querySelector<HTMLElement>('[data-hero-slider]');

	if (root) {
		const sliders = Array.from(root.querySelectorAll<HTMLElement>('.slider'));
		const dialog = root.querySelector<HTMLDialogElement>('.lightbox-dialog')!;
		const dialogTrack = dialog.querySelector<HTMLElement>('.lightbox-dialog__track')!;
		const dialogPrev = dialog.querySelector<HTMLButtonElement>('.slider__arrow--prev')!;
		const dialogNext = dialog.querySelector<HTMLButtonElement>('.slider__arrow--next')!;
		const dialogClose = dialog.querySelector<HTMLButtonElement>('.lightbox-dialog__close')!;

		const lockPageScroll = () => {
			document.documentElement.classList.add('lightbox-open');
		};

		const unlockPageScroll = () => {
			document.documentElement.classList.remove('lightbox-open');
		};

		dialog.addEventListener('close', unlockPageScroll);

		let active: HTMLElement | null = sliders.find((s) => !s.hidden) ?? null;
		let current = 0;

		const getTrack = (s: HTMLElement) => s.querySelector<HTMLElement>('.slider__track')!;
		const getSlides = (s: HTMLElement) =>
			Array.from(s.querySelectorAll<HTMLElement>('.slider__slide'));
		const getDots = (s: HTMLElement) =>
			Array.from(s.querySelectorAll<HTMLButtonElement>('.slider-dot'));

		const setActiveDot = (s: HTMLElement, index: number) => {
			getDots(s).forEach((dot, i) => {
				const on = i === index;
				dot.classList.toggle('slider-dot--active', on);
				if (on) dot.setAttribute('aria-current', 'true');
				else dot.removeAttribute('aria-current');
			});
		};

		const goTo = (s: HTMLElement, index: number, smooth = true) => {
			const slides = getSlides(s);
			const i = (index + slides.length) % slides.length;
			getTrack(s).scrollTo({ left: slides[i].offsetLeft, behavior: smooth ? 'smooth' : 'auto' });
			setActiveDot(s, i);
			return i;
		};

		sliders.forEach((s) => {
			const track = getTrack(s);
			const slides = getSlides(s);

			// Sincroniza el punto activo cuando el usuario hace swipe o scroll nativo
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							const index = Number((entry.target as HTMLElement).dataset.index);
							if (s === active) current = index;
							setActiveDot(s, index);
						}
					});
				},
				{ root: track, threshold: 0.6 }
			);
			slides.forEach((slide) => observer.observe(slide));

			getDots(s).forEach((dot) =>
				dot.addEventListener('click', () => goTo(s, Number(dot.dataset.index)))
			);
			s.querySelector('.slider__arrow--prev')?.addEventListener('click', () =>
				goTo(s, current - 1)
			);
			s.querySelector('.slider__arrow--next')?.addEventListener('click', () =>
				goTo(s, current + 1)
			);
			track.addEventListener('keydown', (e) => {
				if (e.key === 'ArrowLeft') goTo(s, current - 1);
				if (e.key === 'ArrowRight') goTo(s, current + 1);
			});

			slides.forEach((slide, i) =>
				slide.addEventListener('click', () => {
					current = i;
					showInDialog();
					lockPageScroll();
					dialog.showModal();
				})
			);
		});

		let animating = false;
		const reducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const slotAt = (i: number) => dialogTrack.children[i] as HTMLElement;
		const currentImg = () => slotAt(1).querySelector<HTMLImageElement>('img')!;
		const lastIndex = () => (active ? getSlides(active).length - 1 : 0);

		const fillSlot = (slot: HTMLElement, index: number) => {
			const source = active ? getSlides(active)[index] : undefined;
			slot.hidden = !source;
			if (!source) return;
			const img = slot.querySelector<HTMLImageElement>('img')!;
			const thumb = source.querySelector('img');
			const src = source.dataset.full ?? thumb?.currentSrc ?? '';
			if (img.getAttribute('src') !== src) img.src = src;
			img.alt = thumb?.alt ?? '';
		};

		const dialogDots = dialog.querySelector<HTMLElement>('.lightbox-dialog__dots')!;

		// Un punto por cada slide del set activo, no solo por las tres precargadas
		const renderDialogDots = () => {
			const total = active ? getSlides(active).length : 0;
			if (dialogDots.children.length !== total) {
				dialogDots.replaceChildren(
					...Array.from({ length: total }, (_, i) => {
						const dot = document.createElement('button');
						dot.type = 'button';
						dot.className = 'slider-dot';
						dot.setAttribute('aria-label', `Ir a la imagen ${i + 1}`);
						dot.addEventListener('click', () => jumpDialog(i));
						return dot;
					})
				);
			}
			Array.from(dialogDots.children).forEach((dot, i) => {
				const on = i === current;
				dot.classList.toggle('slider-dot--active', on);
				if (on) dot.setAttribute('aria-current', 'true');
				else dot.removeAttribute('aria-current');
			});
		};

		const jumpDialog = (index: number) => {
			if (animating || !active || index === current) return;
			if (Math.abs(index - current) === 1) {
				stepDialog(index - current);
				return;
			}
			current = index;
			showInDialog();
			goTo(active, current, false);
		};

		// Solo se cargan las imágenes vecinas que existen (anterior y siguiente)
		const showInDialog = () => {
			dialogTrack.style.transition = 'none';
			dialogTrack.style.transform = '';
			fillSlot(slotAt(0), current - 1);
			fillSlot(slotAt(1), current);
			fillSlot(slotAt(2), current + 1);
			dialogPrev.disabled = current <= 0;
			dialogNext.disabled = current >= lastIndex();
			renderDialogDots();
		};

		const settle = (delta: number) => {
			if (!active) return;
			current += delta;
			if (delta > 0) dialogTrack.append(dialogTrack.firstElementChild!);
			else dialogTrack.prepend(dialogTrack.lastElementChild!);
			showInDialog();
			goTo(active, current, false);
			animating = false;
		};

		const stepDialog = (delta: number) => {
			const target = current + delta;
			if (animating || !active || target < 0 || target > lastIndex()) return;
			if (reducedMotion()) {
				settle(delta);
				return;
			}
			animating = true;
			dialogTrack.style.transition = 'transform 250ms ease-out';
			dialogTrack.style.transform = `translateX(${-delta * 100}%)`;
			window.setTimeout(() => settle(delta), 260);
		};

		dialogPrev.addEventListener('click', () => stepDialog(-1));
		dialogNext.addEventListener('click', () => stepDialog(1));
		dialogClose.addEventListener('click', () => dialog.close());
		dialog.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowLeft') stepDialog(-1);
			if (e.key === 'ArrowRight') stepDialog(1);
		});
		const dialogContent = dialog.querySelector<HTMLElement>('.lightbox-dialog__content')!;

		// El track sigue al dedo durante el swipe y luego se ajusta a la imagen vecina
		let touchStart: { x: number; y: number } | null = null;
		let dragging = false;
		let dragX = 0;
		const SWIPE_THRESHOLD = 50;

		dialogContent.addEventListener('pointerdown', (e) => {
			if (
				e.pointerType !== 'touch' ||
				!e.isPrimary ||
				animating ||
				(e.target as HTMLElement).closest('button')
			) {
				return;
			}
			touchStart = { x: e.clientX, y: e.clientY };
			dragging = false;
			dragX = 0;
		});
		dialogContent.addEventListener('pointermove', (e) => {
			if (e.pointerType !== 'touch' || !touchStart) return;
			const deltaX = e.clientX - touchStart.x;
			const deltaY = e.clientY - touchStart.y;
			if (!dragging) {
				if (Math.abs(deltaX) < 8 || Math.abs(deltaX) <= Math.abs(deltaY)) return;
				dragging = true;
			}
			const atEdge = (deltaX > 0 && current <= 0) || (deltaX < 0 && current >= lastIndex());
			dragX = atEdge ? deltaX * 0.3 : deltaX;
			dialogTrack.style.transition = 'none';
			dialogTrack.style.transform = `translateX(${dragX}px)`;
		});
		const endDrag = (e: PointerEvent, cancelled: boolean) => {
			if (e.pointerType !== 'touch' || !touchStart) return;
			const wasDragging = dragging;
			const delta = dragX;
			touchStart = null;
			dragging = false;
			dragX = 0;
			if (!wasDragging) return;
			const target = current + (delta < 0 ? 1 : -1);
			if (!cancelled && Math.abs(delta) >= SWIPE_THRESHOLD && target >= 0 && target <= lastIndex()) {
				stepDialog(delta < 0 ? 1 : -1);
				return;
			}
			dialogTrack.style.transition = reducedMotion() ? 'none' : 'transform 200ms ease-out';
			dialogTrack.style.transform = '';
		};
		dialogContent.addEventListener('pointerup', (e) => endDrag(e, false));
		dialogContent.addEventListener('pointercancel', (e) => endDrag(e, true));
		dialog.addEventListener('click', (e) => {
			const target = e.target as HTMLElement;
			if (target.closest('button')) return;
			const clickedImage = currentImg().getBoundingClientRect();
			const clickedImageArea =
				e.clientX >= clickedImage.left &&
				e.clientX <= clickedImage.right &&
				e.clientY >= clickedImage.top &&
				e.clientY <= clickedImage.bottom;

			if (!clickedImageArea) dialog.close();
		});

		$selectedVariant.subscribe((variant) => {
			sliders.forEach((s) => {
				s.hidden = s.dataset.slider !== variant;
			});
			active = sliders.find((s) => !s.hidden) ?? null;
			current = 0;
			if (dialog.open) dialog.close();
			if (active) goTo(active, 0, false);
		});
	}
</script>

<style lang="scss">
	@use "../../styles/base/breakpoints" as *;

	$arrow-size: var(--space-2);
	$dot-size: 0.5rem;
	$accent: var(--color-accent);

	.hero-slider {
		width: 100%;
		height: calc(16 * var(--space));
	}

	.slider {
		position: relative;
		width: 100%;
		height: 100%;

		&[hidden] {
			display: none;
		}

		&__track {
			display: flex;
			width: 100%;
			height: 100%;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			scrollbar-width: none;
			-webkit-overflow-scrolling: touch;

			&::-webkit-scrollbar {
				display: none;
			}
		}

		&__slide {
			flex: 0 0 100%;
			height: 100%;
			scroll-snap-align: center;
			scroll-snap-stop: always;
			cursor: zoom-in;
		}

		&__img {
			display: block;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		&__arrow {
			position: absolute;
			top: 50%;
			transform: translateY(-50%);
			display: none;
			align-items: center;
			justify-content: center;
			width: $arrow-size;
			height: $arrow-size;
			padding: 0;
			border: 0;
			border-radius: 50%;
			background: var(--color-white-translucent);
			color: $accent;
			cursor: pointer;
			opacity: 0;
			transition: opacity 0.25s ease, background 0.25s ease;
			backdrop-filter: blur(4px);

			svg {
				width: 1.25rem;
				height: 1.25rem;
				fill: none;
				stroke: currentColor;
				stroke-width: 1.25;
				stroke-linecap: round;
				stroke-linejoin: round;
			}

			&:hover,
			&:focus-visible {
				background: var(--color-white);
				opacity: 1;
			}

			&--prev {
				left: 0.75rem;
			}
			&--next {
				right: 0.75rem;
			}
		}

		@media (hover: hover) and (min-width: 768px) {
			&__arrow {
				display: flex;
			}
			&:hover &__arrow,
			&:focus-within &__arrow {
				opacity: 1;
			}
		}
	}

	.slider-dots {
		position: absolute;
		left: 50%;
		bottom: var(--space);
		transform: translateX(-50%);
		display: flex;
		align-items: center;
		gap: var(--space-half);
		height: var(--space);
		padding: 0 var(--space-half);
		border-radius: var(--space-half);
		background: var(--color-white-translucent);
		backdrop-filter: blur(4px);
	}

	// :global porque los puntos del lightbox se crean con JS y no reciben el atributo de scope de Astro
	:global(.slider-dot) {
		width: $dot-size;
		height: $dot-size;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: $accent;
		opacity: 0.35;
		cursor: pointer;
		transition: opacity 0.25s ease, transform 0.25s ease;

		&:hover {
			opacity: 0.6;
		}

		&:global(.slider-dot--active) {
			opacity: 1;
			transform: scale(1.4);
		}
	}

	.lightbox-dialog {
		width: 100vw;
		height: 100vh;
		max-width: 100vw;
		max-height: 100vh;
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		overflow: hidden;

		&[open] {
			display: grid;
			place-items: center;
		}

		&::backdrop {
			background: var(--color-white-translucent);
			backdrop-filter: blur(12px);
		}

		&__content {
			position: relative;
			display: flex;
			align-items: center;
			justify-content: center;
			width: min(92vw, 1100px);
			height: 90vh;
			touch-action: pan-y;
		}

		&__img {
			display: block;
			max-width: 100%;
			max-height: 100%;
			object-fit: contain;
			border-radius: 0.5rem;
			box-shadow: var(--box-shadow);
			user-select: none;
			-webkit-user-drag: none;
		}

		&__track {
			position: absolute;
			inset: 0;
			will-change: transform;

			@media (hover: hover) and (min-width: $breakpoint-desktop) {
				overflow: hidden;
			}
		}

		&__slide {
			position: absolute;
			inset: 0;
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 0 var(--space);

			&[hidden] {
				display: none;
			}

			&:nth-child(1) {
				transform: translateX(-100%);
			}
			&:nth-child(3) {
				transform: translateX(100%);
			}

			@media (min-width: $breakpoint-desktop) {
				padding: 0 calc(4 * var(--space));
			}
		}

		&__close {
			position: absolute;
			top: 0;
			right: 0;
			z-index: 1;
			width: $arrow-size;
			height: $arrow-size;
			padding: 0;
			border: 0;
			border-radius: 50%;
			background: var(--color-white-translucent);
			backdrop-filter: blur(4px);
			color: $accent;
			cursor: pointer;
			display: flex;
			align-items: center;
			justify-content: center;

			svg {
				width: 1.25rem;
				height: 1.25rem;
				fill: none;
				stroke: currentColor;
				stroke-width: 1.25;
				stroke-linecap: round;
			}
		}

		&__dots {
			z-index: 1;
			bottom: 0;
		}

		&__nav {
			opacity: 1;
			z-index: 1;

			&:disabled {
				opacity: 0.25;
				cursor: default;
			}
		}

		@media (hover: hover) and (min-width: 768px) {
			&__nav {
				display: flex;
			}
		}
	}

	:global(html.lightbox-open body) {
		position: fixed;
		top: var(--lightbox-scroll-y);
		width: 100%;
		overflow: hidden;
	}

	@media (min-width: $breakpoint-tablet) {
		.hero-slider {
			height: calc(31 * var(--space));
		}
	}

	@media (min-width: $breakpoint-desktop) {
		.hero-slider {
			height: calc(27 * var(--space));
		}
	}
</style>
