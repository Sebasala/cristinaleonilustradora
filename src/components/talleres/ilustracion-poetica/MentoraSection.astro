---
import type { ImageMetadata } from "astro";
import { Image } from 'astro:assets';

interface Props {
	content: {
		eyebrow: string;
		name: string;
		role: string;
		bio: string;
		quote: string;
	};
	image: ImageMetadata;
}

const { content, image } = Astro.props;
const { eyebrow, name, role, bio, quote } = content;
---

<section class="mentora">
	<Image class="image" src={image} alt="Cristina" widths={[496]} />
	<div class="copy">
		<p class="eyebrow">{eyebrow}</p>
		<h2>{name}</h2>
		<p class="rol">{role}</p>
		<p>{bio}</p>
		<blockquote>
			<p>{quote}</p>
		</blockquote>
	</div>
</section>

<style lang="scss">
	@use "../../../styles/base/breakpoints" as *;

	.mentora {
		.image {
			margin: 0 auto var(--space-2);
			border-radius: var(--space);
		}

		@media screen and (min-width: $breakpoint-tablet) {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--space);

            .image {
                margin: 0 auto;
                transform: rotate(0deg);
				grid-column: 2;
				grid-row: 1;
				height: calc(17 * var(--space));
            }

			.copy {
				grid-column: 1;
				grid-row: 1;
			}
        }
	}
</style>
