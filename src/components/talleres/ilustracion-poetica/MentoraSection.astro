---
import { Image } from 'astro:assets';

interface Props {
	eyebrow: string;
	name: string;
	role: string;
	bio: string;
	quote: string;
	image: ImageMetadata
}

const { eyebrow, name, role, bio, quote, image } = Astro.props;
---

<section class="mentora">
	<Image src={image} alt="Cristina" width={340} />
	<p class="eyebrow">{eyebrow}</p>
	<h2>{name}</h2>
	<p class="rol">{role}</p>
	<p>{bio}</p>
	<blockquote>
		<p>{quote}</p>
	</blockquote>
</section>

<style>
	.mentora {
		img {
			margin-bottom: var(--space-2);
			border-radius: var(--space);
		}
	}
</style>
