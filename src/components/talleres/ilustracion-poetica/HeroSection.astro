---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
	hero: {
		subtitle: string;
		title: string;
		hook: string;
		intro: string;
	};
	image: ImageMetadata;
}

const { hero, image } = Astro.props;
---

<section class="hero">
	<Image src={image} alt="Pájaro" width={340} />
	<div class="copy">
		<p class="eyebrow">{hero.subtitle}</p>
		<h1>{hero.title}</h1>
		<p class="hook">{hero.hook}</p>
		<p>{hero.intro}</p>
	</div>
</section>

<style>
	img {
		margin: 0 auto var(--space-2);
	}

	.eyebrow {
		margin: 0;
	}

	@media screen and (min-width: 760px) {
		.hero {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			align-items: center;

			img, .copy {
				grid-row: 1;
			}

			img {
				transform: scaleX(-1);
				grid-column: 2;
				
			}

			.copy {
				grid-column: 1;
			}
		}
	}
</style>
