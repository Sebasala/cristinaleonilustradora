---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
	content: {
		subtitle: string;
		title: string;
		hook: string;
		intro: string;
	};
	image: ImageMetadata;
}

const { content, image } = Astro.props;
---

<section class="content">
	<Image class="image" src={image} alt="Pájaro" widths={[496]} />
	<div class="copy">
		<p class="eyebrow">{content.subtitle}</p>
		<h1>{content.title}</h1>
		<p class="hook">{content.hook}</p>
		<p>{content.intro}</p>
	</div>
</section>

<style>
	.image {
		margin: 0 auto var(--space-2);
		max-width: 496px;
		width: 100%;
	}

	.eyebrow {
		margin: 0;
	}

	@media screen and (min-width: 760px) {
		.content {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			align-items: center;
			gap: var(--space);

			.image {
				transform: scaleX(-1);
				grid-column: 2;
				margin: 0;
				
			}

			.copy {
				grid-column: 1;
				grid-row: 1;
			}
		}
	}
</style>
