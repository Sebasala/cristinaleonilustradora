---
const {
  content
} = Astro.props;

const {
  error,
  label,
  name,
  placeholder = "",
  required = true,
  minLength = 10,
  type = "tel",
  value = "",
} = content;

const errorId = `${name}-error`;
const phonePattern = "[0-9]{3}[ \\-]?[0-9]{1}[ \\-]?[0-9]{2}[ \\-]?[0-9]{2}[ \\-]?[0-9]{2}";
---

<div class="field-wrapper" data-field-wrapper>
  <label class="field-label" for={name}>
    <span>{label ?? name}: </span>
    <span class="visually-hidden">
      El indicativo de Colombia +57 ya está incluido. Ingresa solo el número de teléfono.
    </span>
    {required && <span class="required-indicator">* </span>}
  </label>

  <div class="phone-input">
    <span aria-hidden="true">+57</span>
    <input
      aria-describedby={errorId}
      aria-invalid="false"
      aria-required={required}
      autocomplete="tel"
      id={name}
      inputmode="numeric"
      maxlength={minLength + 4}
      minlength={required ? minLength : undefined}
      name={name}
      pattern={phonePattern}
      placeholder={placeholder}
      required={required}
      type={type}
      value={value}
    />
  </div>

  <p id={errorId} class="field-error" role="alert" hidden aria-live="polite">
    {error}
  </p>
</div>

