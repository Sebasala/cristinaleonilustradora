---
interface Paso {
	numero: string | number;
	title: string;
}

interface Props {
	pasos: Paso[];
	currentStep?: number;
	ariaLabel?: string;
}

const { pasos, currentStep = 1, ariaLabel = "Progreso del formulario" } = Astro.props;
---

<div class="progress" aria-label={ariaLabel}>
	{pasos.map((paso, index) => {
		const stepNumber = index + 1;
		const isActive = stepNumber === currentStep;
		const isComplete = stepNumber < currentStep;

		return (
			<div class:list={["progress-step", { active: isActive, complete: isComplete }]} data-progress-step={stepNumber}>
				<p class="progress-number">{paso.numero}</p>
				<p>{paso.title}</p>
			</div>
		);
	})}
</div>

<style>
	p {
		text-align: center;
	}

	.progress-number {
		border: 1px solid var(--color-black);
		width: var(--space);
		height: var(--space);
		align-content: center;
		border-radius: 50%;
		margin: 0 auto;
	}
	.progress {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space);
		margin-bottom: var(--space);
	}

	.progress-step {
		opacity: var(--opacity-medium);
	}

	.progress-step.active,
	.progress-step.complete {
		opacity: var(--opacity-full);
		p {
			color: var(--color-accent);
			opacity: var(--opacity-full);
		}

		.progress-number {
			border-color: var(--color-accent);
		}
	}

	.progress-step.active {
		.progress-number {
			background-color: var(--color-accent);
			color: var(--color-light);
		}
	}
</style>
