---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
interface Item {
	question: string;
	answer: string;
}

interface Props {
	content: {
		title: string;
		items: Item[];
	};
	image: ImageMetadata;
}

const { content, image } = Astro.props;
const { title, items } = content;
---

<section class="faq">
	<Image class="image" src={image} alt="Planta" widths={[150]} />
	<div class="copy">
		<h2>{title}</h2>
		<div class="faq-list">
			{items.map((item) => (
				<details class="faq-item" name="faq">
					<summary>{item.question}</summary>
					<p>{item.answer}</p>
				</details>
			))}
		</div>
	</div>
</section>

<style lang="scss">
	@use "../../../styles/base/breakpoints" as *;

	.image {
		margin: 0 auto var(--space);
		width: 140px;
		transform: rotate(-10deg);

		@media screen and (min-width: $breakpoint-tablet) {
			margin: 120px 0 0;
		}
	}
	
	.copy {

		@media screen and (min-width: $breakpoint-tablet) {
			height: calc(20 * var(--space));
		}
	}

	.faq-item {
		border-bottom: 1px solid var(--color-accent);
		padding: calc(0.5 * var(--space)) 0;
		overflow: hidden;

		p {
			margin-top: var(--space);
			max-width: calc(var(--text-max-width) - var(--space) * 5);
		}

		summary {
			align-items: center;
			color: var(--color-accent);
			cursor: pointer;
			display: flex;
			gap: var(--space-half);
			justify-content: space-between;
			line-height: var(--space);
			list-style: none;

			&::-webkit-details-marker {
				display: none;
			}

			&::after {
				content: "+";
				color: var(--color-accent);
			}
		}

		&:last-child {
			border-bottom: 0;
		}

		&::details-content {
			block-size: 0;
			transition: block-size 0.2s linear allow-discrete, content-visibility 0.2s linear allow-discrete;
		}
	}

	.faq-item[open] {
		summary::after {
			content: "−";
		}
		
		&::details-content {
			block-size: auto;
		}
	}

	.faq-list {
		height: calc(16 * var(--space));
		@media screen and (min-width: $breakpoint-tablet) {
			.faq-item {
				padding: calc(0.5 * var(--space)) var(--space);
				background-color: var(--color-accent-light);
				border: 1px solid var(--color-accent);
				border-radius: calc(1 * var(--space));
				margin-bottom: var(--space);
			}
		}
	}

	.faq {
		margin: 0 auto;

		@media screen and (min-width: $breakpoint-tablet) {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--space-2);
			align-items: start;
        }
	}
</style>


