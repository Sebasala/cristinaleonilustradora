---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
interface Item {
	question: string;
	answer: string;
}

interface Props {
	content: {
		title: string;
		items: Item[];
	};
	image: ImageMetadata;
}

const { content, image } = Astro.props;
const { title, items } = content;
---

<section class="faq">
	<Image class="image" src={image} alt="Planta" widths={[150]} />
	<div class="copy">
		<h2>{title}</h2>
		<div class="faq-list">
			{items.map((item) => (
				<details class="faq-item">
					<summary>{item.question}</summary>
					<p>{item.answer}</p>
				</details>
			))}
		</div>
	</div>
</section>

<style>
	.image {
		margin: 0 auto var(--space);
		width: 140px;
		transform: rotate(-10deg);
		@media screen and (min-width: 760px) {
			margin: 0;
		}
	}
	
	.copy {

		@media screen and (min-width: 1400px) {
			width: 100%;
		}
	}

	.faq-item {
		border-bottom: 1px solid var(--color-accent);
		padding: calc(0.5 * var(--space)) 0;

		&:last-child {
			border-bottom: 0;
		}
	}

	.faq-item summary {
		cursor: pointer;
		list-style: none;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
	}

	.faq-item summary::-webkit-details-marker {
		display: none;
	}

	.faq-item summary::after {
		content: "+";
		color: var(--color-accent);
	}

	.faq-item[open] summary::after {
		content: "−";
	}

	.faq-item p {
		margin-top: var(--space);
	}

	.faq-list {
		display: grid;

		@media screen and (min-width: 760px) {
			.faq-item {
				padding: calc(0.5 * var(--space)) var(--space);
				background-color: var(--color-accent-light);
				border: 1px solid var(--color-accent);
				border-radius: calc(1 * var(--space));
				margin-bottom: var(--space);
			}
		}
	}

	.faq {
		margin: 0 auto;

		@media screen and (min-width: 760px) {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--space-2);
			align-items: end;
        }
	}
</style>


