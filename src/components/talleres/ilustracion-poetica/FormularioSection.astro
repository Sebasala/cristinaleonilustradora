---
import type { ImageMetadata } from "astro";

interface Paso {
	numero: number;
	title: string;
	fields: string[];
}

interface Precio {
	valorTotal: string;
	descripcion: string;
	facilidadesPago: string[];
	preguntaFiltro: string;
}

interface Props {
	content: {
		title: string;
		pasos: Paso[];
		precio: Precio;
	};
	image: ImageMetadata;
}

const { content } = Astro.props;
const { title } = content;
---

<section class="formulario" id="formulario">
	<div class="copy">
		<h2>{title}</h2>
	</div>
</section>
