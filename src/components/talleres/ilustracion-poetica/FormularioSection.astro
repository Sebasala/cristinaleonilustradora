---
import type { ImageMetadata } from "astro";
import LeadCaptureForm from "./LeadCaptureForm.astro";
import type { FormularioContent } from "./formulario.types";

interface Props {
	content: FormularioContent;
	image: ImageMetadata;
}

const { content } = Astro.props;
const { title } = content;
---

<section class="formulario" id="formulario">
	<div class="copy">
		<h2>{title}</h2>
	</div>
	<LeadCaptureForm content={content} />
</section>
