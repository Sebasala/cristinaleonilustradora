---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
interface Detalle {
	label: string;
	value: string;
}

interface Props {
	content: {
		title: string;
		detalles: Detalle[];
	};
	image: ImageMetadata;
}

const { content, image } = Astro.props;
const { title, detalles } = content;
---

<section class="logistica">
	<Image class="image" src={image} alt="Hoja" widths={[145, 180]} />
	<div class="copy">
		<h2>{title}</h2>
		<ul>
			{detalles.map((detalle) => (
				<li>
					<strong>{detalle.label}:</strong> {detalle.value}
				</li>
			))}
		</ul>
	</div>
</section>

<style>
	.image {
		margin: 0 auto var(--space);
		height: 272px;
		object-fit: contain;
	}
	ul {
		list-style: none;
	}

	@media screen and (min-width: 760px) {
		.logistica {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--space);
			align-items: center;

			.image {
				margin: 0 auto;
				transform: rotate(0deg);
				grid-column: 2;
				grid-row: 1;
				height: 336px;
			}

			.copy {
				grid-column: 1;
				grid-row: 1;
			}
		}
	}
</style>
