---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
interface Detalle {
	label: string;
	value: string;
}

interface Props {
	content: {
		title: string;
		detalles: Detalle[];
	};
	image: ImageMetadata;
}

const { content, image } = Astro.props;
const { title, detalles } = content;
---

<section class="logistica">
	<Image class="image" src={image} alt="Hoja" widths={[145, 180]} />
	<div class="copy">
		<h2>{title}</h2>
		<ul>
			{detalles.map((detalle) => (
				<li>
					<strong>{detalle.label}:</strong> {detalle.value}
				</li>
			))}
		</ul>
	</div>
</section>

<style lang="scss">
	@use "../../../styles/base/breakpoints" as *;

	.image {
		width: 100px;
		object-fit: contain;
		object-position: right;
		margin-left: auto;
		transform: translateX(-50px) rotate(-100deg);
	}
	ul {
		list-style: none;
		margin: 0;
	}

	li {
		&:last-child {
			margin-bottom: 0;
		}
	}

	@media screen and (min-width: $breakpoint-tablet) {
		.logistica {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--space);
			align-items: end;

			.image {
				grid-column: 2;
				grid-row: 1;
			}

			.copy {
				grid-column: 1;
				grid-row: 1;
			}
		}
	}
</style>
