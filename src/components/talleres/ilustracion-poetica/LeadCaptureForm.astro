---
import FormHeading from "./FormHeading.astro";

const { content } = Astro.props;
const { title, heading, description } = content;
---

<section class="form" id="form">
	<FormHeading eyebrow={title} heading={heading} description={description} id="lead-form-title" />
	<form class="lead-form" id="lead-capture-form" novalidate aria-labelledby="lead-form-title">
		<h2>Form</h2>
	</form>
</section>

<style>
	.form {
		max-width: var(--text-max-width);
		margin: calc(4 * var(--space)) auto;
	}
	.copy {
		margin: 0;
	}
</style>

<script src="./lead-capture-form.ts"></script>
