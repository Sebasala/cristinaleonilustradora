---
import FormHeading from "./FormHeading.astro";
import FormStatus from "./FormStatus.astro";
import FormSuccess from "./FormSuccess.astro";
import Progress from "./Progress.astro";
import StepOne from "./StepOne.astro";
import StepThree from "./StepThree.astro";
import StepTwo from "./StepTwo.astro";

const { content } = Astro.props;
const { title, eyebrow, description, steps, success } = content;

const adminWhatsapp = import.meta.env.ADMIN_WHATSAPP_PHONE;
const whatsappHref = adminWhatsapp
	? `https://wa.me/${adminWhatsapp}?text=${encodeURIComponent(success.whatsappMessage)}`
	: undefined;
---

<section class="form" id="form">
	<FormHeading eyebrow={eyebrow} heading={title} description={description} id="lead-form-title" />
	<form class="lead-form" id="lead-capture-form" aria-labelledby="lead-form-title" novalidate>
		<Progress steps={steps} />
		<div class="form-steps">
			<StepOne content={steps[0]} />
			<StepTwo content={steps[1]} />
			<StepThree content={steps[2]} />
		</div>

		<div class="step-actions">
			<button type="button" class="button button-secondary step-back" data-step-action="prev" hidden>
				Volver
			</button>
			<button type="button" class="button step-next" data-step-action="next">
				Siguiente
			</button>
			<button type="submit" class="button step-submit" data-step-action="submit" hidden>
				Reservar mi cupo
			</button>
		</div>

		<FormStatus />
	</form>

	<FormSuccess
		title={success.title}
		message={success.message}
		whatsappHref={whatsappHref}
		whatsappLabel={success.whatsappLabel}
		whatsappMessage={success.whatsappMessage}
	/>
</section>

<style lang="scss">
	@use "../../../styles/base/breakpoints" as *;

	.form {
		max-width: var(--text-max-width);
		margin: calc(4 * var(--space)) auto;
	}

	.copy {
		margin: 0;
	}
	.step-actions {
		display: flex;
		justify-content: flex-end;
		gap: var(--space-half);
		margin-top: var(--space-2);
	}

	.button {
		appearance: none;
		border: none;
		border-radius: var(--space);
		cursor: pointer;
		font: inherit;
		padding: var(--space-half) var(--space);
	}

	.button:hover {
		opacity: 0.96;
		transform: translateY(-1px);
	}

	.button.is-disabled {
		opacity: var(--opacity-medium);
		cursor: not-allowed;
		transform: none;
	}

	.button-secondary {
		border: 1px solid var(--color-accent);
		color: var(--color-accent);
	}

	@media screen and (min-width: $breakpoint-tablet) {
		.step-actions {
			flex-direction: row;
			justify-content: flex-end;
		}

		.button {
			width: auto;
		}
	}
</style>

<script>
	import { initializeLeadCaptureForm } from "@scripts/leadCaptureForm";

	initializeLeadCaptureForm();
</script>
