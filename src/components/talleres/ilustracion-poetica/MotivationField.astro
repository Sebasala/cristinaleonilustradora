---
const { content } = Astro.props;

const {
  error,
  label,
  name,
  placeholder = "",
  required = true,
  minLength = 10,
  rows = 5,
  value = "",
} = content;

const errorId = `${name}-error`;
// TODO: Block this textarea to be resizable;
---

<div class="field-wrapper" data-field-wrapper>
  <label class="textarea-label" for={name}>
    <span>{label}</span>
    {required && <span class="required-indicator"> *</span>}
  </label>

  <textarea
    aria-describedby={errorId}
    aria-invalid="false"
    aria-required={required}
    id={name}
    minlength={required ? minLength : undefined}
    name={name}
    placeholder={placeholder}
    required={required}
    rows={rows}
  >{value}</textarea>

  <p id={errorId} class="field-error" role="status" hidden aria-live="polite">
    {error}
  </p>
</div>

<style lang="scss">
  @use "../../../styles/base/breakpoints" as *;


    textarea {
        height: calc(5 * var(--space));
        resize: none; // Block this textarea from being resizable
    }
    .field-wrapper {
        min-height: calc(9 * var(--space));

        @media (min-width: $breakpoint-tablet) {
            min-height: calc(9 * var(--space));
        }
    }
</style>

