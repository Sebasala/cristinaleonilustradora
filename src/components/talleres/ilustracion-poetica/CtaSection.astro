---
import type { ImageMetadata } from "astro";

interface Props {
	content: {
		text: string;
		label: string;
		link: string;
	};
	image: ImageMetadata;
}

const { content } = Astro.props;
const { text, label, link } = content;
---

<section class="cta copy">
	<p>{text}</p>
	<a href={link} class="button">
		{label}
	</a>
</section>

<style>
	.cta {
		text-align: center;
		position: sticky;
		top: -100px;
		display: block;
		z-index: 10;
		background: linear-gradient(180deg, var(--color-light) 0%, var(--color-light) 50%, transparent 100%);
		padding: var(--space-2) 0;

		@media (min-width: 347px) {
			top: -80px;
		}
	}

	.copy {
		max-width: 100%;

		p {
			margin: 0 auto var(--space);
		}
	}
</style>
