---
import type { ImageMetadata } from "astro";

interface Props {
	content: {
		text: string;
		label: string;
		link: string;
	};
	image: ImageMetadata;
}

const { content } = Astro.props;
const { text, label, link } = content;
---

<section class="cta copy">
	<p>{text}</p>
	<a href={link} class="button">
		{label}
	</a>
</section>

<style>
	.cta {
		text-align: center;
	}
</style>
