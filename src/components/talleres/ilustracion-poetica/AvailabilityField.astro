---
const { content } = Astro.props;

const {
  error,
  label,
  name,
  opciones = [],
  required = true,
} = content;

const errorId = `${name}-error`;
---

<div class="options-wrapper" data-field-wrapper>
  <fieldset class="option-fieldset">
    <legend class="options-label">
      <span>{label}</span>
      {required && <span class="required-indicator"> *</span>}
    </legend>

    <div class="option-grid" role="group" aria-label={label}>
      {opciones.map((option: string, index: number) => {
        const optionId = `${name}-${index}`;

        return (
          <label class="choice-card" for={optionId}>
            <input
              id={optionId}
              name={name}
              type="radio"
              value={option}
              required={required}
              checked={index === 0}
            />
            <span>{option}</span>
          </label>
        );
      })}
    </div>
  </fieldset>

  <p id={errorId} class="field-error" role="status" hidden aria-live="polite">
    {error}
  </p>
</div>

