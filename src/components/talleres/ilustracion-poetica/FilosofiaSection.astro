---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
interface Props {
	content: {
        title: string;
	    text: string;
    }
    image: ImageMetadata;
}

const { content, image } = Astro.props;
const { title, text } = content;
---

<section class="filosofia">
    <Image class="image" src={image} alt="Hoja" widths={[100]} />
	<div class="copy">
        <h2>{title}</h2>
        <p>{text}</p>
    </div>
</section>

<style>
    .image {
        margin: 0 auto var(--space-2);
        transform: rotate(-90deg);
        height: 100px;
        object-fit: contain;
    }
    .filosofia {
        padding: 0;

        @media screen and (min-width: 760px) {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            align-items: center;

            .image {
                margin: 0 auto var(--space-2);
                transform: rotate(0deg);
                margin: 0 auto;
            }
        }
    }
</style>
