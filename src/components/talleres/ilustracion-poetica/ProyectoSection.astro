---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Ruta {
	title: string;
	description: string;
}

interface Props {
	content: {
		title: string;
		description: string;
		rutas: Ruta[];
		subtitle: string;
	}
	image: ImageMetadata;
}

const { content, image } = Astro.props;
const { title, description, rutas, subtitle } = content;
---

<section class="proyecto">
	<Image class="image" src={image} alt="Pez" widths={[476, 496]}/>
	<div class="copy">
		<p class="eyebrow">{subtitle}</p>
		<h2>{title}</h2>
		<p>{description}</p>
		<div class="grid-dos">
			{rutas.map((ruta) => (
				<article class="card">
					<h3>{ruta.title}</h3>
					<p>{ruta.description}</p>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.proyecto {
		.image {
			margin: 0 auto var(--space-2);
		}

		.card {
			margin: 0 0 var(--space);

			&:last-child {
				margin-bottom: 0;
			}
		}

		@media screen and (min-width: 760px) {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--space);
			align-items: center;

            .image {
                margin: 0 auto;
				height: calc(18 * var(--space));
				object-fit: contain;
            }
        }
	}
	


</style>
