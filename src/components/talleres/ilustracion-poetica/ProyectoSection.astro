---
import { Image } from 'astro:assets';

interface Ruta {
	title: string;
	description: string;
}

interface Props {
	title: string;
	description: string;
	rutas: Ruta[];
	image: ImageMetadata;
}

const { title, description, rutas, image } = Astro.props;
---

<section class="proyecto">
	<Image src={image} alt="Pez" width={340}/>
	<div class="copy">
		<h2>{title}</h2>
		<p>{description}</p>
		<div class="grid-dos">
			{rutas.map((ruta) => (
				<article class="card">
					<h3>{ruta.title}</h3>
					<p>{ruta.description}</p>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.proyecto {
		img {
			margin: 0 auto var(--space-2);
		}

		.card {
			padding: 0.75rem 0;
		}

		@media screen and (min-width: 760px) {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--space-2);
			align-items: center;

            img {
                margin: 0 auto var(--space-2);
                transform: rotate(0deg);
            }
        }
	}
	


</style>
