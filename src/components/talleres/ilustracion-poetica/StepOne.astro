---
import type { FormularioContent } from "./formulario.types";

interface Props {
	content: FormularioContent;
}

const { content } = Astro.props;
const { fields } = content;
const { fullName, whatsapp } = fields;
---

<section class="form-step" data-step="1" aria-labelledby="step-1-title">

	<div class="field-group">
		<label for="full-name">{fullName.label}</label>
		<input id="full-name" name="fullName" type="text" autocomplete="name" minlength="3" required aria-describedby="full-name-error" />
		<p class="field-error" id="full-name-error" data-error-for="fullName" aria-live="polite"></p>
	</div>

	<div class="field-group">
		<label for="whatsapp">{whatsapp.label}</label>
		<div class="phone-input">
			<span aria-hidden="true">+57</span>
			<input id="whatsapp" name="whatsapp" type="tel" inputmode="numeric" autocomplete="tel-national" maxlength="10" placeholder={whatsapp.placeholder} required aria-describedby="whatsapp-help whatsapp-error" />
		</div>
		<p class="field-error" id="whatsapp-error" data-error-for="whatsapp" aria-live="polite"></p>
	</div>

	<div class="step-actions">
		<button class="button button-primary" type="button" data-next="2">{content.ui.continueAvailability}</button>
	</div>
</section>

<style>
	.form-step {
		@media screen and (min-width: 760px) {
			margin: var(--space) 0;
		}
	}
</style>
