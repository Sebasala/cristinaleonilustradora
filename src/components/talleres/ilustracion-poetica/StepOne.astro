---
import LocationField from "./LocationField.astro";
import TextField from "./TextField.astro";
import WhatsAppField from "./WhatsAppField.astro";

const { content } = Astro.props;
const { fields } = content;
const { name, whatsapp, location } = fields;
---

<section class="form-step is-active" data-step-index="0">
    <TextField content={name} />
    <WhatsAppField content={whatsapp} />
    <LocationField content={location} />
</section>
