---
interface Props {
  eyebrow?: string;
  heading: string;
  description: string;
  id?: string;
}

const { eyebrow, heading, description, id = "lead-form-title" } = Astro.props;
---

<section class="form-heading">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id}>{heading}</h2>
  <p>{description}</p>
</section>

<style lang="scss">
  @use "../../../styles/base/breakpoints" as *;
  .form-heading {
    margin: var(--space) 0;
    
    @media screen and (min-width: $breakpoint-tablet) {
      margin: var(--space) 0;
    }
  }

  .eyebrow {
    padding-top: var(--space);
  }
</style>