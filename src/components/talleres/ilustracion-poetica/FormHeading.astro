---
interface Props {
  eyebrow?: string;
  heading: string;
  description: string;
  id?: string;
}

const { eyebrow, heading, description, id = "lead-form-title" } = Astro.props;
---

<section class="form-heading">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id}>{heading}</h2>
  <p>{description}</p>
</section>

<style>
  .form-heading {
    margin-bottom: var(--space);
    
    @media screen and (min-width: 760px) {
      margin: var(--space) 0;
    }
  }
</style>