---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
interface Props {
	content: {
		title: string;
		description: string;
		quote: string;
		quoteAuthor: string;
	}
	image: ImageMetadata;
}

const { content, image } = Astro.props;
const { title, description, quote, quoteAuthor } = content;
---

<section class="espacio">
	<div class="image-container">
		<Image class="image" src={image} alt="Planta" widths={[200]} />
	</div>
	<div class="copy">
		<h2>{title}</h2>
		<p>{description}</p>
		<blockquote>
			<p>{quote}</p>
			<cite>{quoteAuthor}</cite>
		</blockquote>
	</div>
</section>

<style>
	.image {
		margin: 0 auto var(--space);
		width: 110px;
	}

	cite {
		opacity: var(--opacity-medium);
	}

	.espacio {
		@media screen and (min-width: 760px) {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--space);
			align-items: end;

            .image {
                margin: 0 0 0 auto;
				grid-column: 2;
				grid-row: 1;
            }

			.copy {
				grid-column: 1;
				grid-row: 1;
			}
        }
	}
</style>
