---
const {
  content
} = Astro.props;

const { 
  error,
  label,
  name,
  placeholder = "",
  required = true,
  minLength = 3,
  type = "text",
  value = "",
} = content;

const errorId = `${name}-error`;
---

<div class="field-wrapper" data-field-wrapper>
  <label class="field-label" for={name}>
    <span>{label ?? name}: </span>
    {required && <span class="required-indicator">* </span>}
  </label>

  <input
    aria-describedby={errorId}
    aria-invalid="false"
    aria-required={required}
    autocomplete="name"
    id={name}
    minlength={required ? minLength : undefined}
    name={name}
    placeholder={placeholder}
    required={required}
    type={type}
    value={value}
  />

  <p id={errorId} class="field-error" role="status" hidden aria-live="polite">
    {error}
  </p>
</div>

