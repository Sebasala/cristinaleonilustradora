---
const {
  content
} = Astro.props;

const { 
  error,
  label,
  name,
  placeholder = "",
  required = true,
  minLength = 3,
  type = "text",
  value = "",
} = content;

const errorId = `${name}-error`;
---

<div class="field-wrapper">
  <label class="field-label" for={name}>
    <span>{label ?? name}: </span>
    {required && <span class="required-indicator">* </span>}
  </label>

  <input
    aria-describedby={errorId}
    aria-invalid="false"
    aria-required={required}
    autocomplete="name"
    id={name}
    minlength={required ? minLength : undefined}
    name={name}
    placeholder={placeholder}
    required={required}
    type={type}
    value={value}
  />

  <p id={errorId} class="field-error" role="status" hidden aria-live="polite">
    {error}
  </p>
</div>

<script is:inline define:vars={{ name, required, errorId, minLength }}>
  const input = document.getElementById(name);
  const errorElement = document.getElementById(errorId);
  const fieldWrapper = input.closest(".field-wrapper");
  let hasBeenBlurred = false;

  function isValid() {
    const value = input.value.trim();

    return input.validity.valid && (!required || value.length >= minLength);
  }

  function updateErrorDisplay() {
    const shouldShow = hasBeenBlurred && !isValid();

    if (shouldShow) {
      errorElement.hidden = false;
      input.setAttribute("aria-invalid", "true");
    } else {
      errorElement.hidden = true;
      input.setAttribute("aria-invalid", "false");
    }

    fieldWrapper.classList.toggle("invalid", shouldShow);
  }

  input.addEventListener("blur", () => {
    hasBeenBlurred = true;
    updateErrorDisplay();
  });

  input.addEventListener("input", () => {
    if (hasBeenBlurred) {
      updateErrorDisplay();
    }
  });
</script>
