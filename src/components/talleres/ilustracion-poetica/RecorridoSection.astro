---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
interface Etapa {
	fase: string;
	title: string;
	details: string;
}

interface Props {
	content: {
		title: string;
		description: string;
		etapas: Etapa[];
	};
	image: ImageMetadata;
}

const { content, image } = Astro.props;
const { title, description, etapas } = content;
---

<section class="recorrido">
	<Image class="image" src={image} alt="Hongos" widths={[50]} />
	<div class="copy">
		<h2>{title}</h2>
		<p>{description}</p>
		<div class="etapas">
			{etapas.map((etapa) => (
				<article class="etapa">
					<p class="eyebrow">{etapa.fase}</p>
					<h3>{etapa.title}</h3>
					<p>{etapa.details}</p>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.image {
			margin: 0 0 0 auto;
			width: 50px;
		}
		.etapa {
			margin: 0 0 var(--space);

			&:last-child {
				margin: 0;
			}
		}
	.recorrido {
		@media screen and (min-width: 760px) {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--space);
			align-items: end;

            .image {
                transform: rotate(0deg);
            }
        }
	}
</style>
