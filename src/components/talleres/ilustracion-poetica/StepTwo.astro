---
import AvailabilityField from "./AvailabilityField.astro";
import MotivationField from "./MotivationField.astro";

const { content } = Astro.props;
const { fields } = content;
const { motivation, disponibilidad } = fields;
---

<section class="form-step" data-step-index="1" data-form-step hidden>
    <MotivationField content={motivation} />
    <AvailabilityField content={disponibilidad} />
</section>
