---
import type { FormularioContent } from "./formulario.types";

interface Props {
	content: FormularioContent;
}

const { content } = Astro.props;
const { pasos, fields, ui } = content;
const { availability, motivation } = fields;
---

<section class="form-step" data-step="2" aria-labelledby="step-2-title" hidden>
	<div class="field-group">
		<label for="motivation">{motivation.label}</label>
		<textarea id="motivation" name="motivation" minlength="10" rows="5" required placeholder={motivation.placeholder} aria-describedby="motivation-error"></textarea>
		<p class="field-error" data-error-for="motivation" aria-live="polite"></p>
	</div>

	<fieldset class="field-group option-fieldset">
		<legend>{availability.label}</legend>
		<div class="option-grid option-grid-three">
			{availability.options?.map((option, index) => (
				<label class="choice-card" for={`availability-${index}`}>
					<input id={`availability-${index}`} type="radio" name="availability" value={option} required />
					<span>{option}</span>
				</label>
			))}
		</div>
		<p class="field-error" data-error-for="availability" aria-live="polite"></p>
	</fieldset>

	<div class="step-actions">
		<button class="button button-secondary" type="button" data-previous="1">{ui.back}</button>
		<button class="button button-primary" type="button" data-next="3">{ui.continueInvestment}</button>
	</div>
</section>
