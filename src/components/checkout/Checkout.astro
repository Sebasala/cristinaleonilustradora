---
import CalendarVariantSelector from '@components/calendar/CalendarVariantSelector.astro';
import QuantitySelector from '@components/calendar/QuantitySelector.astro';
import CustomerContactForm from '@components/checkout/CustomerContactForm.astro';
import ShippingDestination from '@components/checkout/ShippingDestination.astro';
import calendarContent from '@data/calendarContent';
import { calendarVariantsList } from '@data/calendarVariants';

const { checkout } = calendarContent;
---

<section id="checkout" class="checkout-section" aria-labelledby="checkout-title">
	<header class="checkout-header">
		<h2 id="checkout-title" class="checkout-title">{checkout.title}</h2>
		<p class="checkout-subtitle">{checkout.subtitle}</p>
	</header>
	<div class="checkout-card">
		<div class="package-selectors">
			<div class="calendar-checkout-selector">
				<CalendarVariantSelector
					idPrefix="checkout-variant"
					variants={calendarVariantsList}
				/>
			</div>
			<QuantitySelector />
		</div>
		<form class="checkout-form" novalidate data-checkout-form>
			<ShippingDestination />
			<CustomerContactForm />
			<button class="button checkout-form__submit" type="submit">{checkout.continueLabel}</button>
		</form>
	</div>
</section>

<script>
	import { $isCheckoutValid } from '@stores/orderStore';

	const form = document.querySelector<HTMLFormElement>('[data-checkout-form]');

	if (form) {
		form.addEventListener('submit', (event) => {
			event.preventDefault();
			window.dispatchEvent(new CustomEvent('checkout:validate'));

			const firstInvalid = form.querySelector<HTMLElement>('[aria-invalid="true"]');
			if (firstInvalid) {
				firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
				firstInvalid.focus({ preventScroll: true });
			} else if ($isCheckoutValid.get()) {
				window.dispatchEvent(new CustomEvent('checkout:valid'));
			} else {
				console.error('Checkout validation failed without an invalid field.');
			}
		});
	} else {
		console.error('Checkout form could not be initialized.');
	}
</script>

<style lang="scss">
	@use "../../styles/base/breakpoints" as *;

	.checkout-header {
		max-width: var(--max-width-2);

		@media screen and (min-width: $breakpoint-desktop) {
			max-width: var(--max-width-3);
		}
	}

	.checkout-card {
		background-color: var(--color-white);
		padding: var(--space-half);
		border-radius: calc(1.5 * var(--space));
		box-shadow: var(--box-shadow);
		max-width: var(--max-width-2);
	}

	.calendar-checkout-selector {
		container-type: inline-size;
		max-width: 377px;
	}

	.checkout-form {
		min-height: 0;
		padding: 0;
	}

	@media screen and (min-width: $breakpoint-tablet) {
		.checkout-card {
			padding: var(--space);
			border-radius: var(--space-2);
		}

		.package-selectors {
			display: flex;
			justify-content: space-between;
			gap: var(--space-half);
		}

		.calendar-checkout-selector {
			width: 50%;
			max-width: 500px;
		}
	}
</style>
