---
import {
CITY_DEPARTMENTS,
COLOMBIA_DEPARTMENTS
} from '@data/colombiaTerritory';

import ShippingAddress from '@components/checkout/ShippingAddress.astro';
import calendarContent from '@data/calendarContent';

const { checkout: { shippingDestination, destinationTitle } } = calendarContent;
const SUGGESTED_CITIES = Object.keys(
	CITY_DEPARTMENTS
);
---

<section
	class="shipping-destination"
	aria-labelledby="shipping-destination-title"
	data-shipping-destination
	data-free-shipping-label={shippingDestination.freeShippingLabel}
>

	<h3 id="shipping-destination-title">{destinationTitle}</h3>
	<!-- // TODO: Add validation messages for shipping destination fields -->
	<div class="shipping-fields">
		<div class="shipping-field">
			<label for="shipping-department">{shippingDestination.departmentLabel}</label>
			<select id="shipping-department" name="department" data-department>
				<option value="">{shippingDestination.departmentPlaceholder}</option>
				{COLOMBIA_DEPARTMENTS.map((department) => (
					<option value={department}>{department}</option>
				))}
			</select>
		</div>

		<div class="shipping-field">
			<label for="shipping-city">{shippingDestination.cityLabel}</label>
			<input
				id="shipping-city"
				name="city"
				type="text"
				list="shipping-city-suggestions"
				placeholder={shippingDestination.cityPlaceholder}
				autocomplete="address-level2"
				data-city
			/>
			<datalist id="shipping-city-suggestions">
				{SUGGESTED_CITIES.map((city) => <option value={city} />)}
			</datalist>
		</div>
	</div>

	<ShippingAddress />

	<div class="totals-container">
		<p class="shipping-costs">{ calendarContent.checkout.shippingCosts }</p>
		<dl class="order-totals" aria-live="polite">
			<div class="total-row">
				<dt>{shippingDestination.subtotalLabel}</dt>
				<dd data-subtotal></dd>
			</div>
			<div class="total-row">
				<dt>{shippingDestination.shippingCostLabel}</dt>
				<dd data-shipping-cost></dd>
			</div>
			<div class="total-row total-row-grand">
				<dt>{shippingDestination.grandTotalLabel}</dt>
				<dd data-grand-total></dd>
			</div>
		</dl>
	</div>
</section>

<script>
	import { formatCOP } from '@data/calendarVariants';
import { getSuggestedCitiesForDepartment } from '@data/colombiaTerritory';
import {
$grandTotal,
$itemQuantity,
$shippingCity,
$shippingCost,
$shippingDepartment,
$subtotal,
} from '@stores/orderStore';

	const root = document.querySelector<HTMLElement>('[data-shipping-destination]');
	const departmentInput = root?.querySelector<HTMLSelectElement>('[data-department]');
	const cityInput = root?.querySelector<HTMLInputElement>('[data-city]');
	const citySuggestions = root?.querySelector<HTMLDataListElement>('#shipping-city-suggestions');
	const subtotalOutput = root?.querySelector<HTMLElement>('[data-subtotal]');
	const shippingOutput = root?.querySelector<HTMLElement>('[data-shipping-cost]');
	const grandTotalOutput = root?.querySelector<HTMLElement>('[data-grand-total]');
	const freeShippingLabel = root?.dataset.freeShippingLabel;

	if (
		departmentInput &&
		cityInput &&
		citySuggestions &&
		subtotalOutput &&
		shippingOutput &&
		grandTotalOutput &&
		freeShippingLabel !== undefined
	) {
		const renderTotals = (): void => {
			const quantity = $itemQuantity.get();

			subtotalOutput.textContent = formatCOP($subtotal.get());
			shippingOutput.textContent =
				quantity >= 3
					? freeShippingLabel
					: formatCOP($shippingCost.get());
			grandTotalOutput.textContent = formatCOP($grandTotal.get());
		};

		const renderCitySuggestions = (department: string): void => {
			const options = getSuggestedCitiesForDepartment(department).map((city) => {
				const option = document.createElement('option');
				option.value = city;
				return option;
			});
			citySuggestions.replaceChildren(...options);
		};

		departmentInput.value = $shippingDepartment.get();
		cityInput.value = $shippingCity.get();
		renderCitySuggestions(departmentInput.value);

		departmentInput.addEventListener('change', () => {
			$shippingDepartment.set(departmentInput.value);
			renderCitySuggestions(departmentInput.value);
		});
		cityInput.addEventListener('input', () => {
			$shippingCity.set(cityInput.value);
		});

		$subtotal.subscribe(renderTotals);
		$shippingCost.subscribe(renderTotals);
		$grandTotal.subscribe(renderTotals);
		$itemQuantity.subscribe(renderTotals);
		$shippingDepartment.subscribe(renderTotals);
		$shippingCity.subscribe(renderTotals);
	}
</script>

<style lang="scss">
	@use "../../styles/base/breakpoints" as *;
	label {
		padding-left: var(--space);
	}

	.shipping-costs {
		margin: var(--space) 0;
	}

	.shipping-destination {
		margin: var(--space-2) 0 0;
	}

	.shipping-title {
		margin: 0 0 var(--space);
	}

	.shipping-fields {
		display: grid;
		gap: var(--space);
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
	}

	.shipping-field {
		position: relative;

		input,
		select {
			appearance: none;
			width: 100%;
			height: var(--space-2);
			padding: var(--space-half) var(--space);
			border: 1px solid var(--color-accent);
			border-radius: var(--space);

			&::-webkit-calendar-picker-indicator {
				appearance: none !important;
				display: none !important;
			}
		}

		select {
			background-image: url('/icons/arrow-down-circle-svgrepo-com.svg');
			background-repeat: no-repeat;
			background-position: right var(--space-half) center;
			background-size: var(--space);
			padding-right: var(--space-2);
		}

		:focus-visible {
			outline: 2px solid var(--color-accent);
			outline-offset: 2px;
		}
	}

	.order-totals {
		max-width: 400px;
		margin: var(--space-2) 0 0 auto;
	}

	.total-row {
		display: flex;
		justify-content: space-between;
		gap: var(--space);
		margin: var(--space) 0;
		line-height: var(--space);
		opacity: var(--opacity-high);


		dd {
			margin: 0;
			text-align: right;
		}
	}

	.total-row-grand {
		padding-top: var(--space);
		border-top: 1px solid var(--color-accent);
		font-size: var(--font-size-2)
	}

	.shipping-provisional {
		margin-left: auto;
		max-width: 400px;
		color: var(--color-black);
		font-size: 0.875rem;
		opacity: var(--opacity-medium);

		&[hidden] {
			display: none;
		}
	}

	@media screen and (min-width: $breakpoint-tablet) {
		.totals-container {
			display: flex;
			gap: var(--space);
			margin-top: var(--space-2);
		}

		.shipping-costs {
			width: 50%;
		}

		.order-totals {
			margin: 0;
			width: 50%;
			max-width: 500px;
		}
		
	}
</style>
