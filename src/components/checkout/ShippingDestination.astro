---
import ShippingAddress from '@components/checkout/ShippingAddress.astro';
import ShippingLocation from '@components/checkout/ShippingLocation.astro';
import calendarContent from '@data/calendarContent';

const { checkout: { shippingDestination, destinationTitle } } = calendarContent;
---

<section
	class="shipping-destination"
	aria-labelledby="shipping-destination-title"
	data-shipping-destination
	data-free-shipping-label={shippingDestination.freeShippingLabel}
>
	<h3 id="shipping-destination-title">{destinationTitle}</h3>
	<ShippingLocation />
	<ShippingAddress />

	<div class="totals-container">
		<p class="shipping-costs">{ calendarContent.checkout.shippingCosts }</p>
		<dl class="order-totals" aria-live="polite">
			<div class="total-row">
				<dt>{shippingDestination.subtotalLabel}</dt>
				<dd data-subtotal></dd>
			</div>
			<div class="total-row">
				<dt>{shippingDestination.shippingCostLabel}</dt>
				<dd data-shipping-cost></dd>
			</div>
			<div class="total-row total-row-grand">
				<dt>{shippingDestination.grandTotalLabel}</dt>
				<dd data-grand-total></dd>
			</div>
		</dl>
	</div>
</section>

<script>
	import { formatCOP } from '@data/calendarVariants';
import { $grandTotal, $itemQuantity, $shippingCost, $subtotal } from '@stores/orderStore';

	const root = document.querySelector<HTMLElement>('[data-shipping-destination]');
	const subtotalOutput = root?.querySelector<HTMLElement>('[data-subtotal]');
	const shippingOutput = root?.querySelector<HTMLElement>('[data-shipping-cost]');
	const grandTotalOutput = root?.querySelector<HTMLElement>('[data-grand-total]');
	const freeShippingLabel = root?.dataset.freeShippingLabel;

	if (subtotalOutput && shippingOutput && grandTotalOutput && freeShippingLabel !== undefined) {
		const renderTotals = (): void => {
			const quantity = $itemQuantity.get();

			subtotalOutput.textContent = formatCOP($subtotal.get());
			shippingOutput.textContent =
				quantity >= 3
					? freeShippingLabel
					: formatCOP($shippingCost.get());
			grandTotalOutput.textContent = formatCOP($grandTotal.get());
		};

		$subtotal.subscribe(renderTotals);
		$shippingCost.subscribe(renderTotals);
		$grandTotal.subscribe(renderTotals);
		$itemQuantity.subscribe(renderTotals);
	}
</script>

<style lang="scss">
	@use "../../styles/base/breakpoints" as *;

	.shipping-costs {
		margin: var(--space) 0;
	}

	.shipping-destination {
		margin: var(--space-2) 0 0;
	}

	.shipping-title {
		margin: 0 0 var(--space);
	}

	.order-totals {
		max-width: 400px;
		margin: var(--space-2) 0 0 auto;
	}

	.total-row {
		display: flex;
		justify-content: space-between;
		gap: var(--space);
		margin: var(--space) 0;
		line-height: var(--space);
		opacity: var(--opacity-high);


		dd {
			margin: 0;
			text-align: right;
		}
	}

	.total-row-grand {
		padding-top: var(--space);
		border-top: 1px solid var(--color-accent);
		font-size: var(--font-size-2)
	}

	.shipping-provisional {
		margin-left: auto;
		max-width: 400px;
		color: var(--color-black);
		font-size: 0.875rem;
		opacity: var(--opacity-medium);

		&[hidden] {
			display: none;
		}
	}

	@media screen and (min-width: $breakpoint-tablet) {
		.totals-container {
			display: flex;
			gap: var(--space);
			margin-top: var(--space-2);
		}

		.shipping-costs {
			width: 50%;
		}

		.order-totals {
			margin: 0;
			width: 50%;
			max-width: 500px;
		}
		
	}
</style>
